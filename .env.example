# ==============================================================================
# Sree AI Landing Page — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' or '.env.local' and provide your actual values.
# Do NOT commit your actual '.env' file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostHog Web Analytics & Telemetry (Client-Side)
# ------------------------------------------------------------------------------
# Public PostHog project API key (obtained from PostHog Project Settings)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key_here

# Ingestion host endpoint (default: https://us.i.posthog.com or https://eu.i.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ------------------------------------------------------------------------------
# 2. Early Access Waitlist Webhook (Server-Side Proxy)
# ------------------------------------------------------------------------------
# Target webhook URL (n8n, Zapier, Make, or custom backend webhook endpoint)
# Receives POST payload: { name, email, platform, client_ip }
EARLY_ACCESS_WEBHOOK_URL=https://your-automation-instance.example.com/webhook/your-webhook-id

# Pre-shared secret header passed as 'X-Webhook-Secret' for request validation
EARLY_ACCESS_WEBHOOK_SECRET=your_secure_webhook_secret_here

# ------------------------------------------------------------------------------
# 3. FAQ Question Submission Webhook (Server-Side Proxy / Optional)
# ------------------------------------------------------------------------------
# Optional dedicated endpoint for visitors submitting questions in the FAQ section.
# If omitted, the route automatically falls back to EARLY_ACCESS_WEBHOOK_URL.
# Receives POST payload: { request_type: "FaqQuestion", question, email, client_ip }
FAQ_QUESTION_WEBHOOK_URL=https://your-automation-instance.example.com/webhook/your-faq-webhook-id
